// FrostyFlow ERP — MySQL schema
//
// Field names are kept snake_case and 1:1 with src/types.ts wherever a direct
// analog exists (store_id, salesperson_id, truck_id, ...) so the future API
// layer can serialize responses with minimal field translation.
//
// Two enum-like fields are intentionally left as plain String instead of a
// Prisma/MySQL enum, because their values contain spaces and aren't valid
// enum identifiers: Store.refill_frequency ('15 Days') and
// Payment.method / Invoice.payment_method ('Google Pay', 'Bank Transfer').
// Allowed values are documented above each field; validation happens at the
// API layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  Admin
  Salesperson
  Warehouse
}

enum Status {
  Active
  Inactive
}

enum UnitType {
  ml
  L
  g
  kg
  pcs
}

enum Ranking {
  Platinum
  Gold
  Silver
  Bronze
}

enum OrderStatus {
  Draft
  Confirmed
  Delivered
  Cancelled
}

enum PreBookingStatus {
  Booked
  Delivered
  Cancelled
}

enum InvoicePaymentStatus {
  Paid
  Partial
  Unpaid
  Credit
}

enum CreditType {
  credit
  debit
}

enum AssetStatus {
  Warehouse
  Assigned
  Maintenance
  Returned
  Lost
  Inactive
}

// Shared by Asset.location_type and InventoryMovement's from/to fields. Asset
// rows are never expected to legally hold location_type=Asset themselves -
// enforced in application code (assets.service.ts), not the type system,
// mirroring how Order.truck_id is optional but validated at the service layer.
enum StockLocationType {
  Warehouse
  Truck
  Partner
  Asset
}

enum AssetEventType {
  Assigned
  Returned
  MaintenanceStart
  MaintenanceEnd
  MarkedLost
  Reactivated
  Deactivated
}

enum NotificationType {
  low_stock
  out_of_stock
  expiry
  refill
  payment_due
  payment_received
  credit_exceeded
  new_order
  order_update
  delivery
  partner_update
  product_update
  user_update
  stock_update
  system
}

// ---------------------------------------------------------------------------
// Users, roles & fleet
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  role          Role
  password_hash String
  status        Status   @default(Active)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  trucks             Truck[]
  orders             Order[]
  pre_booking_orders PreBookingOrder[]
  payments_collected Payment[]
  store_visits       StoreVisit[]
  user_permissions   UserPermission[]

  @@map("users")
}

model Truck {
  id             String   @id @default(uuid())
  vehicle_number String   @unique
  // Nullable so deactivating a truck (trucks.service.ts setStatus 'Inactive'
  // - the UI's "delete" action, a soft delete) can clear the assignment
  // instead of leaving a decommissioned truck still pointing at a driver.
  // Create/update still require a driver via zod (trucks.controller.ts) -
  // this only ever goes null through the deactivate path.
  driver_user_id String?
  driver         User?    @relation(fields: [driver_user_id], references: [id])
  route          String
  area           String
  status         Status   @default(Active)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  truck_inventory TruckInventory[]
  orders          Order[]

  @@map("trucks")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id     String @id @default(uuid())
  name   String @unique
  status Status @default(Active)

  products Product[]

  @@map("categories")
}

model Product {
  id                     String    @id @default(uuid())
  name                   String
  code                   String    @unique
  category_id            String
  category               Category  @relation(fields: [category_id], references: [id])
  brand                  String
  description            String    @db.Text
  image_url              String?   @db.LongText
  mrp                    Decimal   @db.Decimal(10, 2)
  purchase_discount_pct  Decimal   @db.Decimal(5, 2)
  wholesale_discount_pct Decimal   @db.Decimal(5, 2)
  retail_discount_pct    Decimal   @db.Decimal(5, 2)
  tax_pct                Decimal   @db.Decimal(5, 2)
  status                 Status    @default(Active)
  unit_value             Decimal   @db.Decimal(10, 2)
  unit_type              UnitType
  /// How many individual pieces make up one box/case of this product (e.g.
  /// a box of 12 cones -> 12). Used to validate the `_pieces` companion
  /// field on every quantity column below (0 <= pieces < pieces_per_box)
  /// and to render "N boxes, M pcs" throughout the app.
  pieces_per_box         Int       @default(1)
  expiry_date            DateTime? @db.Date
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  scheduled_prices             ScheduledPrice[]
  warehouse_inventory          WarehouseInventory?
  truck_inventory              TruckInventory[]
  purchase_items               PurchaseItem[]
  purchase_order_request_items PurchaseOrderRequestItem[]
  order_items                  OrderItem[]
  pre_booking_items            PreBookingItem[]
  pre_booking_dispatched_items PreBookingDispatchedItem[]
  store_pricing_overrides      StorePricing[]
  partner_inventory_entries    PartnerInventory[]
  asset_inventory_entries      AssetInventory[]
  inventory_movements          InventoryMovement[]

  @@map("products")
}

model ScheduledPrice {
  id             String   @id @default(uuid())
  product_id     String
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  purchase_price Decimal  @db.Decimal(10, 2)
  selling_price  Decimal  @db.Decimal(10, 2)
  effective_date DateTime @db.Date
  applied        Boolean  @default(false)

  @@map("scheduled_prices")
}

// ---------------------------------------------------------------------------
// Suppliers & purchasing (stock coming IN)
// ---------------------------------------------------------------------------

model Supplier {
  id             String   @id @default(uuid())
  name           String
  contact_person String
  phone          String
  email          String
  address        String   @db.Text
  status         Status   @default(Active)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  purchases               Purchase[]
  purchase_order_requests PurchaseOrderRequest[]

  @@map("suppliers")
}

model Purchase {
  id             String   @id @default(uuid())
  supplier_id    String
  supplier       Supplier @relation(fields: [supplier_id], references: [id])
  invoice_number String
  date           DateTime @db.Date
  created_at     DateTime @default(now())

  /// The supplier's own bill/price-list sent back after packing the order -
  /// stored as a base64 data URI (like Product.image_url) since there's no
  /// object storage backend. Can be a photo, PDF, or spreadsheet; bill_file_type
  /// (a MIME type) tells the UI how to preview/open it.
  bill_file_url  String? @db.LongText
  bill_file_name String?
  bill_file_type String?

  items             PurchaseItem[]
  fulfilled_request PurchaseOrderRequest?

  @@index([date])
  @@index([invoice_number])
  @@map("purchases")
}

model PurchaseItem {
  id             String    @id @default(uuid())
  purchase_id    String
  purchase       Purchase  @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id     String
  product        Product   @relation(fields: [product_id], references: [id])
  quantity       Int
  /// Loose pieces received in addition to `quantity` whole boxes (0 <=
  /// quantity_pieces < Product.pieces_per_box). See WarehouseInventory for
  /// the box/pieces convention shared across every quantity field.
  quantity_pieces Int      @default(0)
  purchase_price Decimal   @db.Decimal(10, 2)
  mfg_date       DateTime? @db.Date
  expiry_date    DateTime? @db.Date

  @@map("purchase_items")
}

enum PurchaseOrderRequestStatus {
  Pending
  Fulfilled
  Cancelled
}

/// A Purchase Order Excel generated from the Warehouse page (product list,
/// no rates) and sent to a supplier. Kept as its own record so the admin
/// doesn't have to retype the same product/quantity list into Receive Stock
/// once the supplier packs the order and sends prices back - they instead
/// pick this request and it pre-fills the manifest.
model PurchaseOrderRequest {
  id          String                     @id @default(uuid())
  order_ref   String                     @unique
  supplier_id String
  supplier    Supplier                   @relation(fields: [supplier_id], references: [id])
  status      PurchaseOrderRequestStatus @default(Pending)
  created_at  DateTime                   @default(now())

  /// Set once Receive Stock is confirmed against this request.
  fulfilled_purchase_id String?   @unique
  fulfilled_purchase    Purchase? @relation(fields: [fulfilled_purchase_id], references: [id])

  items PurchaseOrderRequestItem[]

  @@map("purchase_order_requests")
}

model PurchaseOrderRequestItem {
  id         String               @id @default(uuid())
  request_id String
  request    PurchaseOrderRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product              @relation(fields: [product_id], references: [id])
  order_case Int
  /// Loose pieces requested in addition to `order_case` whole boxes.
  order_case_pieces Int           @default(0)

  @@map("purchase_order_request_items")
}

// ---------------------------------------------------------------------------
// Inventory (warehouse & trucks)
// ---------------------------------------------------------------------------

/// Every stock quantity in this schema is stored as a whole-box count plus a
/// companion `_pieces` loose-piece count (0 <= pieces < Product.pieces_per_box,
/// normalized/carried by backend/src/utils/pieceQty.ts on every write) so
/// stock can be tracked and moved in partial boxes, not just whole cases.
model WarehouseInventory {
  product_id       String   @id
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  available_qty    Int      @default(0)
  available_pieces Int      @default(0)
  reserved_qty     Int      @default(0)
  reserved_pieces  Int      @default(0)
  damaged_qty      Int      @default(0)
  damaged_pieces   Int      @default(0)
  expired_qty      Int      @default(0)
  expired_pieces   Int      @default(0)
  updated_at       DateTime @updatedAt

  @@map("warehouse_inventory")
}

model TruckInventory {
  truck_id        String
  truck           Truck   @relation(fields: [truck_id], references: [id], onDelete: Cascade)
  product_id      String
  product         Product @relation(fields: [product_id], references: [id])
  quantity        Int     @default(0)
  quantity_pieces Int     @default(0)

  @@id([truck_id, product_id])
  @@map("truck_inventory")
}

// ---------------------------------------------------------------------------
// Partner stores
// ---------------------------------------------------------------------------

// Manageable list of district areas offered on the Store form's "District
// Area" dropdown. Store.area itself stays a plain string (matched by name,
// not a foreign key) so renaming/removing an area here never touches
// existing store rows directly - deletion is blocked instead while any
// store still references the name (see areas.service.ts).
model Area {
  id   String @id @default(uuid())
  name String @unique

  @@map("areas")
}

// Manageable list offered on the Partner form's "Village" dropdown, same
// pattern as Area above (Store.village is a denormalized string matched by
// name, not a foreign key - see Store.village's own comment).
model Village {
  id   String @id @default(uuid())
  name String @unique

  @@map("villages")
}

model Store {
  id                  String    @id @default(uuid())
  name                String
  owner_name          String
  phone               String
  alt_phone           String?
  address             String    @db.Text
  area                String
  // Denormalized against Village.name, NOT a foreign key - same reasoning as
  // `area` above (renaming/removing a village should never need to cascade
  // through Store rows via FK). Nullable/optional since it's a new field -
  // existing stores simply have no village until edited, unlike `area`
  // which has always been required.
  village             String?
  city                String
  state               String
  pincode             String
  gst_number          String?
  credit_limit        Decimal   @db.Decimal(10, 2)
  outstanding_balance Decimal   @default(0) @db.Decimal(10, 2)
  /// Allowed values: 'Weekly' | '15 Days' | 'Monthly' | 'Custom'
  refill_frequency    String
  custom_days         Int?
  last_purchase_date  DateTime? @db.Date
  next_refill_date    DateTime? @db.Date
  ranking             Ranking   @default(Bronze)
  /// Denormalized string matched against PartnerType.name, NOT a foreign key -
  /// same reasoning as `area` above (renaming/removing a PartnerType should
  /// never need to touch Store rows via FK cascade). Existing stores backfill
  /// to 'Retail Shop' automatically via this default.
  partner_type        String    @default("Retail Shop")
  status              Status    @default(Active)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  orders             Order[]
  pre_booking_orders PreBookingOrder[]
  payments           Payment[]
  credit_ledger      CreditLedger[]
  visits             StoreVisit[]
  pricing_overrides  StorePricing[]
  assets             Asset[]
  partner_inventory  PartnerInventory[]
  asset_history      AssetAssignmentHistory[]

  @@map("stores")
}

// Per-store, per-product discount overrides - lets a partner outlet get its
// own negotiated wholesale/retail rate instead of the catalog default.
// Either field may be left null to keep tracking that side of the catalog's
// rate live (a snapshot copy would go stale the next time the catalog
// price changes); a row with both null is meaningless and should just be
// deleted instead (see storePricing.service.ts).
model StorePricing {
  id                     String   @id @default(uuid())
  store_id               String
  store                  Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  product_id             String
  product                Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  wholesale_discount_pct Decimal? @db.Decimal(5, 2)
  retail_discount_pct    Decimal? @db.Decimal(5, 2)
  updated_at             DateTime @updatedAt

  @@unique([store_id, product_id])
  @@map("store_pricing")
}

model StoreVisit {
  id             String    @id @default(uuid())
  store_id       String
  store          Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  salesperson_id String
  salesperson    User      @relation(fields: [salesperson_id], references: [id])
  date           DateTime  @default(now())
  notes          String    @db.Text
  follow_up_date DateTime? @db.Date
  completed      Boolean   @default(true)

  @@map("store_visits")
}

// ---------------------------------------------------------------------------
// Orders (immediate truck-stock sales) & invoicing
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(uuid())
  store_id       String
  store          Store       @relation(fields: [store_id], references: [id])
  salesperson_id String
  salesperson    User        @relation(fields: [salesperson_id], references: [id])
  truck_id       String?
  truck          Truck?      @relation(fields: [truck_id], references: [id])
  status         OrderStatus @default(Draft)
  created_at     DateTime    @default(now())

  items    OrderItem[]
  invoice  Invoice?
  payments Payment[]

  /// Set when this order was generated by delivering a pre-booking (see
  /// PreBookingOrder.fulfilled_order_id) - lets an Admin edit/delete a
  /// Delivered pre-booking by operating on the real order/invoice/stock it
  /// actually produced, the same way editOrder/deleteOrder already do for
  /// ordinary orders.
  fulfilled_prebooking PreBookingOrder?

  @@index([created_at])
  @@index([status])
  @@index([status, created_at])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product @relation(fields: [product_id], references: [id])
  quantity   Int
  quantity_pieces Int @default(0)
  unit_price Decimal @db.Decimal(10, 2)
  tax_pct    Decimal @db.Decimal(5, 2)
  /// Preserves the order items were added/edited in (bills must show this,
  /// not a DB-default row order, which follows the random UUID primary key
  /// rather than insertion order). Set from the submitted array index.
  position   Int     @default(0)

  @@map("order_items")
}

model Invoice {
  id             String                @id @default(uuid())
  order_id       String                @unique
  order          Order                 @relation(fields: [order_id], references: [id])
  invoice_number String                @unique
  total          Decimal               @db.Decimal(10, 2)
  tax            Decimal               @db.Decimal(10, 2)
  grand_total    Decimal               @db.Decimal(10, 2)
  /// Indian tax-invoice "Round Off": grand_total minus the exact (unrounded)
  /// total+tax, e.g. -0.40 when the exact bill of 245.60 was rounded up to
  /// Rs 246. Always present (0 when no rounding was needed).
  round_off      Decimal               @default(0) @db.Decimal(10, 2)
  created_at     DateTime              @default(now())
  paid_amount    Decimal?              @db.Decimal(10, 2)
  payment_status InvoicePaymentStatus?
  /// Allowed values: 'Cash' | 'UPI' | 'Google Pay' | 'PhonePe' | 'Paytm' | 'Bank Transfer' | 'Credit'
  payment_method String?

  @@index([created_at])
  @@index([payment_status])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Pre-bookings (reserve now, deliver later)
// ---------------------------------------------------------------------------

model PreBookingOrder {
  id                      String           @id @default(uuid())
  store_id                String
  store                   Store            @relation(fields: [store_id], references: [id])
  salesperson_id          String
  salesperson             User             @relation(fields: [salesperson_id], references: [id])
  created_at              DateTime         @default(now())
  scheduled_delivery_date DateTime         @db.Date
  status                  PreBookingStatus @default(Booked)
  notes                   String?          @db.Text

  items            PreBookingItem[]
  dispatched_items PreBookingDispatchedItem[]

  /// Set once this booking is delivered - points at the real Order it
  /// produced (deliverPreBooking creates a brand-new Order with no other
  /// link back to the booking that spawned it). Lets an Admin edit/delete a
  /// Delivered booking by operating on that real order/invoice/stock.
  fulfilled_order_id String? @unique
  fulfilled_order    Order?  @relation(fields: [fulfilled_order_id], references: [id])

  @@index([created_at])
  @@index([status])
  @@index([scheduled_delivery_date])
  @@index([status, scheduled_delivery_date])
  @@map("pre_booking_orders")
}

model PreBookingItem {
  id             String          @id @default(uuid())
  pre_booking_id String
  pre_booking    PreBookingOrder @relation(fields: [pre_booking_id], references: [id], onDelete: Cascade)
  product_id     String
  product        Product         @relation(fields: [product_id], references: [id])
  quantity       Int
  quantity_pieces Int            @default(0)
  unit_price     Decimal         @db.Decimal(10, 2)
  tax_pct        Decimal         @db.Decimal(5, 2)
  /// Preserves the order items were added/edited in (bills must show this,
  /// not a DB-default row order, which follows the random UUID primary key
  /// rather than insertion order). Set from the submitted array index.
  position       Int             @default(0)

  @@map("pre_booking_items")
}

/// Tracks cargo already physically loaded onto a truck ahead of the
/// scheduled delivery date, so the delivery-confirmation step doesn't
/// deduct warehouse stock twice for the same units.
model PreBookingDispatchedItem {
  id             String          @id @default(uuid())
  pre_booking_id String
  pre_booking    PreBookingOrder @relation(fields: [pre_booking_id], references: [id], onDelete: Cascade)
  product_id     String
  product        Product         @relation(fields: [product_id], references: [id])
  quantity       Int
  quantity_pieces Int            @default(0)

  @@map("pre_booking_dispatched_items")
}

// ---------------------------------------------------------------------------
// Payments & credit
// ---------------------------------------------------------------------------

model Payment {
  id                String   @id @default(uuid())
  store_id          String
  store             Store    @relation(fields: [store_id], references: [id])
  order_id          String?
  order             Order?   @relation(fields: [order_id], references: [id])
  amount            Decimal  @db.Decimal(10, 2)
  /// Allowed values: 'Cash' | 'UPI' | 'Google Pay' | 'PhonePe' | 'Paytm' | 'Bank Transfer' | 'Credit'
  method            String
  date              DateTime @default(now())
  collected_by      String
  collected_by_user User     @relation(fields: [collected_by], references: [id])

  @@index([date])
  @@map("payments")
}

model CreditLedger {
  id        String     @id @default(uuid())
  store_id  String
  store     Store      @relation(fields: [store_id], references: [id])
  amount    Decimal    @db.Decimal(10, 2)
  type      CreditType
  date      DateTime   @default(now())
  reference String

  @@map("credit_ledger")
}

// ---------------------------------------------------------------------------
// Partner types & asset (freezer box / fridge / cart) management
// ---------------------------------------------------------------------------

// Manageable list of partner-type labels offered on the Store form's
// "Partner Type" dropdown - same pattern as Area (see Store.partner_type
// comment above). 'Retail Shop' is the seeded default and cannot be deleted.
model PartnerType {
  id   String @id @default(uuid())
  name String @unique

  @@map("partner_types")
}

// Manageable list of asset-type labels (Freezer Box, Refrigerator, Deep
// Freezer, Ice Cream Cart, ...) - same pattern as PartnerType/Area.
model AssetType {
  id   String @id @default(uuid())
  name String @unique

  @@map("asset_types")
}

// A physical unit of cold-chain hardware (freezer box, fridge, cart, ...)
// FrostyFlow owns and places with partners. asset_type is a denormalized
// string matched against AssetType.name, NOT a foreign key (same reasoning
// as Store.partner_type/area).
model Asset {
  id                  String            @id @default(uuid())
  name                String
  code                String            @unique
  asset_type          String
  serial_number       String?
  capacity            String?
  status              AssetStatus       @default(Warehouse)
  /// Where the physical unit currently sits. location_id is a soft reference
  /// (like AuditLog.entity_id) - it alternately points at Truck.id or
  /// Store.id depending on location_type, so it can't be a single hard FK;
  /// resolved by app-layer lookup in assets.service.ts. Null when Warehouse.
  location_type       StockLocationType @default(Warehouse)
  location_id         String?
  /// Kept in sync ONLY by assignAsset()/returnAsset() in assets.service.ts -
  /// mirrors location_id when location_type=Partner, modeled as a real FK
  /// (unlike location_id) so partner-facing reports/joins don't need a
  /// manual resolve step. Cleared to null whenever the asset leaves a partner.
  assigned_partner_id String?
  assigned_partner    Store?            @relation(fields: [assigned_partner_id], references: [id])
  assigned_date       DateTime?         @db.Date
  last_service_date   DateTime?         @db.Date
  notes               String?           @db.Text
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  history   AssetAssignmentHistory[]
  inventory AssetInventory[]

  @@index([status])
  @@index([asset_type])
  @@index([assigned_partner_id])
  @@map("assets")
}

/// Structured, queryable ledger for the Asset Assignment History Report -
/// not reconstructed from free-text AuditLog details. Every write here is
/// paired with a logAudit() call so the existing Movement Logs screen also
/// shows these actions (see assets.service.ts).
model AssetAssignmentHistory {
  id          String         @id @default(uuid())
  asset_id    String
  asset       Asset          @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  event_type  AssetEventType
  partner_id  String?
  partner     Store?         @relation(fields: [partner_id], references: [id])
  from_status AssetStatus?
  to_status   AssetStatus
  date        DateTime       @default(now())
  /// actor_id is an intentional soft reference (same reasoning as
  /// AuditLog.user_id) - actor_name/actor_role are snapshotted at write time
  /// so this row still displays correctly if the user is later removed.
  actor_id    String
  actor_name  String?
  actor_role  String?
  notes       String?        @db.Text

  @@index([asset_id, date])
  @@map("asset_assignment_history")
}

/// Live stock snapshot of what's currently placed with a partner outside of
/// a formal priced Order (e.g. consignment stock) - mirrors TruckInventory.
model PartnerInventory {
  partner_id String
  partner    Store    @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product  @relation(fields: [product_id], references: [id])
  quantity   Int      @default(0)
  quantity_pieces Int @default(0)
  updated_at DateTime @updatedAt

  @@id([partner_id, product_id])
  @@map("partner_inventory")
}

/// Live stock snapshot for an asset that opts into its own stock tracking
/// (e.g. a Freezer Box) - mirrors TruckInventory.
model AssetInventory {
  asset_id   String
  asset      Asset    @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  product_id String
  product    Product  @relation(fields: [product_id], references: [id])
  quantity   Int      @default(0)
  quantity_pieces Int @default(0)
  updated_at DateTime @updatedAt

  @@id([asset_id, product_id])
  @@map("asset_inventory")
}

/// Generalized inventory-movement ledger covering every from/to pair across
/// Warehouse, Truck, Partner and Asset locations. Complements, does NOT
/// replace, AuditLog - every movement here also gets a logAudit() row so the
/// Movement Logs screen's entity_type dropdown stays the one place operators
/// look for a human-readable trail; this table is the structured, queryable
/// source for movement-specific reports. from/to_location_id are soft
/// references (Truck.id / Store.id / Asset.id depending on the paired
/// location_type) - null when the corresponding side is Warehouse.
model InventoryMovement {
  id                 String            @id @default(uuid())
  from_location_type StockLocationType
  from_location_id   String?
  to_location_type   StockLocationType
  to_location_id     String?
  product_id         String
  product            Product           @relation(fields: [product_id], references: [id])
  quantity           Int
  quantity_pieces    Int               @default(0)
  reason             String?           @db.Text
  actor_id           String
  actor_name         String?
  actor_role         String?
  created_at         DateTime          @default(now())

  @@index([created_at])
  @@index([from_location_type, from_location_id])
  @@index([to_location_type, to_location_id])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Notifications, audit trail & misc settings
// ---------------------------------------------------------------------------

/// entity_type/entity_id are an intentional soft reference (same reasoning as
/// AuditLog above), not a hard foreign key: not every notification is about a
/// specific record (e.g. type 'system'), and a notification must still
/// display correctly if the record it pointed to is later deleted. Both are
/// nullable for that reason - only set when the notification has somewhere
/// to navigate to.
model AppNotification {
  id          String           @id @default(uuid())
  type        NotificationType
  message     String           @db.Text
  entity_type String?
  entity_id   String?
  is_read     Boolean          @default(false)
  created_at  DateTime         @default(now())

  @@index([created_at])
  @@index([is_read])
  @@index([entity_type, entity_id])
  @@map("notifications")
}

/// user_id is an intentional soft reference, NOT a hard foreign key: the app
/// uses the literal value 'system' for automated actions, and audit rows must
/// still display correctly if the underlying user is later removed. user_name
/// / user_role are snapshotted at write time for exactly this reason (mirrors
/// resolveActor() in the current frontend's storage.ts).
model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity_type String
  entity_id   String
  user_id     String
  user_name   String?
  user_role   String?
  timestamp   DateTime @default(now())
  details     String   @db.Text

  @@index([timestamp, id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
}

/// Singleton row (id is always 1) holding the admin-configurable UPI QR code
/// shown to stores at checkout.
model QrCodeSettings {
  id         Int     @id @default(1)
  image_url  String  @db.LongText
  is_enabled Boolean @default(true)

  @@map("qr_code_settings")
}

/// Admin-toggleable feature flags scoped to a role, e.g. letting Admin grant
/// the Salesperson role access to the GST/non-GST order toggle. Absence of a
/// row for a given (role, feature) pair means "disabled" — rows only need to
/// be written when a feature is turned on, or flipped back off.
model RolePermission {
  id         String   @id @default(uuid())
  role       Role
  feature    String
  enabled    Boolean  @default(false)
  updated_at DateTime @updatedAt

  @@unique([role, feature])
  @@map("role_permissions")
}

/// Per-operator override of a role-default screen/tab or named feature flag
/// (see RolePermission above). Unlike RolePermission, ABSENCE of a row here
/// means "no override — inherit the role default," not "disabled" — presence
/// of a row means this specific operator has an explicit override, and
/// `enabled` is that override's value. `feature` is namespaced by role (e.g.
/// "Admin:Orders") so that if an operator's role is later changed, old
/// override rows are harmlessly orphaned instead of silently misapplying
/// under the new role's screen set.
model UserPermission {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  feature    String
  enabled    Boolean  @default(false)
  updated_at DateTime @updatedAt

  @@unique([user_id, feature])
  @@map("user_permissions")
}

/// Server-side mirror of the client's offline write queue, kept only if the
/// offline-first UX is preserved against the real API (see open question in
/// the migration analysis). Safe to drop this model if that flow is retired.
model SyncQueueItem {
  id        String   @id @default(uuid())
  action    String
  payload   Json
  timestamp DateTime @default(now())

  @@map("sync_queue")
}
