# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native project source (android/, ios/, windows/, macos/) is committed —
# this repo is bare, not managed/CNG, so only build OUTPUT is ignored below.

# Android build output
/android/app/build/
/android/.gradle/
/android/build/

# Stray local Android SDK components (accidentally installed into the repo's
# android/ dir instead of the real SDK root at C:/Android) — not project source.
/android/build-tools/
/android/licenses/
/android/platforms/

# iOS/macOS build output + CocoaPods local state
/ios/build/
/ios/Pods/
/macos/build/
/macos/Pods/
*.xcworkspace

# Windows build output
/windows/*/Debug/
/windows/*/Release/
/windows/*/ARM64/
/windows/*/x64/
/windows/*/x86/
/windows/*/AppPackages/
/windows/*/BundleArtifacts/
/windows/target/
/windows/packages/
/windows/*.opendb
/windows/*.db
