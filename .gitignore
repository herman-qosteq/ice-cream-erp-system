# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Native project source (frontend/android/, frontend/ios/, frontend/windows/,
# frontend/macos/) is committed — this repo is bare, not managed/CNG, so only
# build OUTPUT is ignored below.

# Android build output
/frontend/android/app/build/
/frontend/android/.gradle/
/frontend/android/build/

# Stray local Android SDK components (accidentally installed into the repo's
# android/ dir instead of the real SDK root at C:/Android) — not project source.
/frontend/android/build-tools/
/frontend/android/licenses/
/frontend/android/platforms/

# iOS/macOS build output + CocoaPods local state
/frontend/ios/build/
/frontend/ios/Pods/
/frontend/macos/build/
/frontend/macos/Pods/
*.xcworkspace

# Windows build output
/frontend/windows/*/Debug/
/frontend/windows/*/Release/
/frontend/windows/*/ARM64/
/frontend/windows/*/x64/
/frontend/windows/*/x86/
/frontend/windows/*/AppPackages/
/frontend/windows/*/BundleArtifacts/
/frontend/windows/target/
/frontend/windows/packages/
/frontend/windows/*.opendb
/frontend/windows/*.db
