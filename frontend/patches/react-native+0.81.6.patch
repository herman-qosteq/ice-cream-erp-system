+const PixelRatio = require('../Utilities/PixelRatio').default;
+const Platform = require('../Utilities/Platform').default;
+const {pickScale} = require('./AssetUtils');
+const {
+  getAndroidResourceFolderName,
+  getAndroidResourceIdentifier,
